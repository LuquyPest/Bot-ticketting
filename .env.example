# Copie ce fichier en .env (chmod 600) et remplis-le — ou laisse scripts/setup.sh le faire.
# Tout se règle ici : config.json n'est plus nécessaire.

# ── Discord (portail développeur : https://discord.com/developers/applications) ──
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Adresse publique du dashboard ──
# Domaine seul (Caddy / Traefik) et URL complète en https (utilisée par Discord pour le retour OAuth2 :
# ajoute  https://<PUBLIC_HOST>/api/auth/discord/callback  dans OAuth2 → Redirects)
PUBLIC_HOST=tickets.example.com
PUBLIC_URL=https://tickets.example.com
# E-mail pour les certificats Let's Encrypt (Caddy) et les notifications push
ACME_EMAIL=
VAPID_CONTACT=

# ── Fichiers compose utilisés (HTTPS) ──
# Caddy inclus (recommandé) :  docker-compose.yml:docker-compose.caddy.yml
# Traefik existant :           docker-compose.yml:docker-compose.traefik.yml
# Aucun proxy (port local) :   docker-compose.yml
# + sauvegarde chaque nuit :   ajouter :docker-compose.backup.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml:docker-compose.backup.yml
# Fuseau horaire (heure des sauvegardes)
TZ=Europe/Paris

# ── Secrets (générés par setup.sh ; à la main : openssl rand -hex 32) ──
DB_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
# Notifications push du dashboard (facultatif) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Propriétaire et serveurs ──
# Le propriétaire de l'instance est le propriétaire de l'application Discord (aucun compte à créer).
# Comptes Discord ajoutés comme co-propriétaires (IDs séparés par des virgules, facultatif)
OWNER_IDS=
# Si renseigné, le bot quitte tout serveur Discord absent de cette liste (IDs séparés par des virgules)
ALLOWED_GUILDS=

# ── Confidentialité ──
# Page de confidentialité à afficher (vide = page intégrée /confidentialite) et e-mail de contact
PRIVACY_URL=
CONTACT_EMAIL=
# Conservation des transcripts en jours (vide ou 0 = indéfiniment)
TRANSCRIPT_RETENTION_DAYS=

# ── Sauvegarde (docker-compose.backup.yml) ──
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30

# ── Avancé ──
# Version de l'image (docker compose pull) : latest, ou un numéro précis comme v2.24
TICKETBOT_VERSION=latest
# Sans proxy : adresse et port locaux publiés par le conteneur
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Nombre de proxys devant l'app (2 derrière Cloudflare) et nom du proxy dont l'en-tête X-Forwarded-For est cru.
# Sans nom de proxy, l'en-tête n'est cru que venant d'une adresse locale ou privée (ton propre proxy).
TRUST_PROXY_HOPS=1
TRUSTED_PROXY_HOST=
