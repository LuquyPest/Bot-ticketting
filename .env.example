# Copie ce fichier en .env et remplis les valeurs avant de lancer docker compose.

# Mot de passe root MariaDB (usage interne Docker uniquement, jamais dans config.json)
# Utilise un mot de passe différent de DB_PASSWORD pour limiter les privilèges
DB_ROOT_PASSWORD=change_me_root

# Mot de passe de l'utilisateur 'botuser'
# Doit correspondre exactement à config.json → database.password
DB_PASSWORD=change_me_botuser

# Mot de passe de Redis (sessions, files d'attente) — commande : openssl rand -hex 32
REDIS_PASSWORD=change_me_redis

# Compte superadmin créé automatiquement au premier démarrage (si la table est vide)
# Mot de passe de 12 caractères minimum. Retire ces deux lignes après le premier lancement réussi
SA_USERNAME=change_me_admin
SA_PASSWORD=change_me_password

# UID/GID de l'utilisateur hôte propriétaire de config.json (commande : id -u / id -g).
# Le bot tourne sous cet utilisateur, ce qui permet de laisser config.json en chmod 600.
BOT_UID=1000
BOT_GID=1000
