# Copie ce fichier en .env (chmod 600) et remplis-le — ou laisse scripts/setup.sh le faire.
# Tout se règle ici : config.json n'est plus nécessaire.

# ── Discord (portail développeur : https://discord.com/developers/applications) — facultatif ──
# DISCORD_TOKEN : le bot (tickets par MP, salons, commandes). DISCORD_CLIENT_ID + DISCORD_CLIENT_SECRET :
# la connexion au dashboard avec Discord. Sans aucun des deux, crée le premier propriétaire sur
# /installation avec INSTALL_TOKEN (openssl rand -hex 24).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
INSTALL_TOKEN=

# ── Adresse publique du dashboard ──
# Domaine seul (Caddy / Traefik) et URL complète en https (utilisée par Discord pour le retour OAuth2 :
# ajoute  https://<PUBLIC_HOST>/api/auth/discord/callback  dans OAuth2 → Redirects)
PUBLIC_HOST=tickets.example.com
PUBLIC_URL=https://tickets.example.com
# E-mail pour les certificats Let's Encrypt (Caddy) et les notifications push
ACME_EMAIL=
VAPID_CONTACT=

# ── Fichiers compose utilisés (HTTPS) ──
# Caddy inclus (recommandé) :  docker-compose.yml:docker-compose.caddy.yml
# Traefik existant :           docker-compose.yml:docker-compose.traefik.yml
# Aucun proxy (port local) :   docker-compose.yml
# + sauvegarde chaque nuit :   ajouter :docker-compose.backup.yml
# + copie hors du serveur :    ajouter :docker-compose.offsite.yml (après backup)
# + bouton de mise à jour :    ajouter :docker-compose.updater.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml:docker-compose.backup.yml
# Connexions à MariaDB (facultatif) : base de l'instance (20) et chaque espace (10)
# DB_POOL_SIZE=20
# DB_TENANT_POOL_SIZE=10

# Fuseau horaire (heure des sauvegardes)
TZ=Europe/Paris

# ── Secrets (générés par setup.sh ; à la main : openssl rand -hex 32) ──
DB_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
# Notifications push du dashboard (facultatif) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Propriétaire et serveurs ──
# Le propriétaire de l'instance est le propriétaire de l'application Discord (aucun compte à créer).
# Comptes Discord ajoutés comme co-propriétaires (IDs séparés par des virgules, facultatif)
OWNER_IDS=
# Si renseigné, le bot quitte tout serveur Discord absent de cette liste (IDs séparés par des virgules)
ALLOWED_GUILDS=

# ── Confidentialité ──
# Page de confidentialité à afficher (vide = page intégrée /confidentialite) et e-mail de contact
PRIVACY_URL=
CONTACT_EMAIL=
# Conservation des transcripts en jours (vide ou 0 = indéfiniment)
TRANSCRIPT_RETENTION_DAYS=

# ── Sauvegarde (docker-compose.backup.yml) ──
# Clé de chiffrement des sauvegardes (openssl rand -hex 32) ; aussi visible du propriétaire dans
# le dashboard (Paramètres → Sécurité). Sans elle, une sauvegarde est indéchiffrable.
BACKUP_KEY=
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30
# Vérifie la dernière archive après la sauvegarde : off, weekly (le dimanche) ou daily
BACKUP_VERIFY=weekly
# Copie hors du serveur (docker-compose.offsite.yml) : destination rclone, ex. b2:mon-bucket/ticketbot
BACKUP_REMOTE=

# ── Tickets par e-mail ──
# true : autorise un serveur IMAP/SMTP sur le réseau local (par défaut : adresses publiques seulement)
EMAIL_ALLOW_PRIVATE_HOSTS=

# ── Mises à jour ──
# off : ne jamais vérifier les nouvelles versions sur GitHub
UPDATE_CHECK=
# Bouton « Mettre à jour » du dashboard (docker-compose.updater.yml) : jeton (openssl rand -hex 32)
# et chemin absolu de ce dossier
UPDATER_TOKEN=
PROJECT_DIR=

# ── Avancé ──
# Version de l'image (docker compose pull) : latest, ou un numéro précis comme v3.3.0
# (l'ancien nom TICKETBOT_VERSION est toujours lu)
DATICK_VERSION=latest
# Sans proxy : adresse et port locaux publiés par le conteneur
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Nombre de proxys devant l'app (2 derrière Cloudflare) et nom du proxy dont l'en-tête X-Forwarded-For est cru.
# Sans nom de proxy, l'en-tête n'est cru que venant d'une adresse locale ou privée (ton propre proxy).
TRUST_PROXY_HOPS=1
TRUSTED_PROXY_HOST=
